{
  "name": "sitter-ranking-playground",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names api,web --prefix-colors blue,magenta \"npm run dev -w @sitter/api\" \"npm run dev -w @sitter/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "vitest run",
    "test:integration": "npm run test:integration -w @sitter/api",
    "db:seed": "npm run db:seed -w @sitter/api",
    "db:generate": "npm run db:generate -w @sitter/api",
    "check": "bash scripts/check.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "24.x"
  }
}
